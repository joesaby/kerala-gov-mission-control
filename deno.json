{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "check:sources": "deno run --allow-read scripts/check-sources.ts",
    "check:ml": "deno run --allow-read scripts/check-ml-glyphs.ts",
    "test": "deno test --unstable-kv lib/",
    "review": "sh scripts/code-review.sh",
    "dev": "deno run -A --unstable-kv --unstable-cron --watch=static/,routes/ dev.ts",
    "build": "deno run -A --unstable-kv --unstable-cron dev.ts build",
    "start": "deno serve -A --unstable-kv --unstable-cron _fresh/server.js",
    "seed": "deno run -A --unstable-kv scripts/seed.ts",
    "fetch-orders": "deno run -A --unstable-kv scripts/fetch-orders.ts",
    "ingest-gos": "deno run -A --unstable-kv scripts/ingest_gos.ts",
    "translate": "uv run scripts/translate.py",
    "translate:test": "sh -c 'cd scripts && uv run --with pytest pytest translate_test.py -v'",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "**/.antigravitycli/*",
    "**/.cache/*",
    "**/.claude/*",
    "**/.pytest_cache/*"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-tailwind": "jsr:@fresh/plugin-tailwind@^1.0.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.3.1",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.10",
    "daisyui": "npm:daisyui@^5.0.43",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.40.0",
    "@std/cli": "jsr:@std/cli@^1.0.20",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.17",
    "@std/path": "jsr:@std/path@^1.0.9"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "fmt": {
    "exclude": ["_fresh/", "static/styles.css"]
  }
}
